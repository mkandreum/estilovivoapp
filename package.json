{
  "name": "estilovivo-android",
  "private": true,
  "version": "1.0.0",
  "description": "App Android de EstiloVivo: contenedor Capacitor de https://estilovivo.xyoncloud.win",
  "type": "module",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "icons": "node scripts/generate-android-icons.mjs",
    "build:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:release": "cap sync android && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor-firebase/crashlytics": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "capacitor-plugin-cdv-purchase": "^13.17.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2"
  }
}
